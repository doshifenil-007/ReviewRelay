# ==========================================
# ReviewRelay Environment Configuration
# ==========================================

# Server Configuration
NODE_ENV=development
APP_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/reviewrelay
REDIS_URL=redis://localhost:6379

# Authentication & JWT
JWT_ACCESS_SECRET=generate-a-unique-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=generate-a-different-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=generate-a-unique-random-secret-at-least-32-characters

# GitHub Webhook Configuration
GITHUB_WEBHOOK_SECRET=generate-a-unique-random-secret-at-least-32-characters

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
